# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------- Keamanan & akses ----------------
# Rahasia penanda tangan sesi login (min. 16 karakter). WAJIB diisi di production.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="a3352a1d9cdfb4e03d434e2fd9b4619c2f423b9296cd0b7ca496115ed039c8d6"

# Lama sesi login (jam). Default 12.
SESSION_HOURS=12

# Password awal untuk akun bawaan saat database pertama kali dibuat (user wajib menggantinya).
# Kosong di production = dibuat acak per akun dan dicetak SEKALI di log server.
SEED_PASSWORD="Awal2026abc"

# DEMO_MODE=true menampilkan daftar akun contoh di halaman login. Default: true di dev, false di production.
DEMO_MODE="false"

# Izinkan tombol "Reset Demo Data" di production (tidak disarankan).
ALLOW_DEMO_RESET=""

# Set true bila aplikasi berada di belakang reverse proxy.
TRUST_PROXY=""
